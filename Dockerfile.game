# Zeabur service name "game" → Dockerfile.game
FROM node:22-alpine AS builder
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json frontend/docker-prepare-web-install.cjs ./
# Skip Electron/electron-builder (they make npm ci ~5min and pull deprecated deps).
# Then install only the Linux musl native bindings Vite/sass need.
# Also rewrite npmmirror tarball URLs to npmjs — Zeabur fetches those slowly.
RUN node docker-prepare-web-install.cjs

COPY frontend/ ./
RUN npm run build:web

FROM nginx:1.27-alpine
COPY nginx.game.conf /etc/nginx/conf.d/configfile.template
COPY docker-entrypoint.game.sh /docker-entrypoint.game.sh
COPY --from=builder /app/dist /usr/share/nginx/html

RUN chmod +x /docker-entrypoint.game.sh

# 默认占位；请在 Zeabur 设置 BACKEND_UPSTREAM 为 backend 的公网域名
ENV PORT=8080 \
    HOST=0.0.0.0 \
    BACKEND_UPSTREAM=http://127.0.0.1:9

EXPOSE 8080
CMD ["/docker-entrypoint.game.sh"]
