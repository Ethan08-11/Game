# Zeabur service name "game" → Dockerfile.game
FROM node:22-alpine AS builder
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
# Web image does not ship the Electron desktop shell. Skipping those optional
# packages avoids electron@43's "needs Node >= 22.12" engine warnings and the
# deprecated rimraf/glob/inflight/boolean tree pulled in by electron-builder.
RUN npm ci --omit=optional

COPY frontend/ ./
RUN npm run build:web

FROM nginx:1.27-alpine
COPY nginx.game.conf /etc/nginx/conf.d/configfile.template
COPY docker-entrypoint.game.sh /docker-entrypoint.game.sh
COPY --from=builder /app/dist /usr/share/nginx/html

RUN chmod +x /docker-entrypoint.game.sh

# 默认占位；请在 Zeabur 设置 BACKEND_UPSTREAM 为 backend 的公网域名
ENV PORT=8080 \
    HOST=0.0.0.0 \
    BACKEND_UPSTREAM=http://127.0.0.1:9

EXPOSE 8080
CMD ["/docker-entrypoint.game.sh"]
